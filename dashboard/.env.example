# Server only. Never prefix these credentials with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-key
# local is for a localhost-only demo. Hosted deployments must use supabase.
DASHBOARD_AUTH_MODE=local
# Hosted authentication: existing Supabase Auth users, email/password login.
# SUPABASE_ANON_KEY=your-publishable-or-anon-key
# DASHBOARD_ALLOWED_EMAILS=teammate@example.com,reviewer@example.com
