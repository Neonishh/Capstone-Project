# ======================
# Node.js (web)
# ======================
web/node_modules/
web/package-lock.json

# Logs & generated files
web/logs/*.json
web/logs/*.html
web/logs/*.txt
web/logs/screenshots/*.png

# ======================
# Python (mobile)
# ======================
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
mobile/venv/
venv/
.venv/
.env
# Mobile logs & generated files
mobile/logs/*.json
mobile/logs/*.txt
mobile/logs/screenshots/*.png
mobile/logs/screenshots/old/*.png

# Python egg / dist
*.egg-info/
dist/
build/

# ======================
# Environment / secrets
# ======================
.env

# ======================
# OS files
# ======================
.DS_Store
Thumbs.db

# Mobile run artifacts (including nested vision runs)
/mobile/logs/

# Local model weights; keep model documentation versionable

/mobile/**/yolov8n.pt

# Generated web vision artifacts
/vision/storage/outputs/
/vision/storage/screenshots/
/vision/temp_screenshots/

# Template run artifacts
/claude_template/logs/

# Local environment variants; allow shareable examples
.env.*
!.env.example
!.env.sample

# Shared database offline bundles and exports
/database/local/
/database/backups/

# Downloaded emulator app binaries
/mobile/apps/*.apk
