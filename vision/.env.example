# Vision Architecture (Architecture B) configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2000
GROQ_TEMPERATURE=0.2

# Optional overrides
YOLO_MODEL_PATH=docling-project/ScreenParser
YOLO_IMGSZ=640
YOLO_CONF=0.15
OCR_MIN_CONF=40
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Service URLs (defaults shown)
YOLO_SERVICE_URL=http://127.0.0.1:5001
OCR_SERVICE_URL=http://127.0.0.1:5002
MERGE_SERVICE_URL=http://127.0.0.1:5003
BROWSER_SERVICE_URL=http://127.0.0.1:5004
VISION_GATEWAY_PORT=5000

