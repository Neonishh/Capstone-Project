[
  {
    "id": "PROFILE-NAME",
    "description": "Illustrative contract: names are required, at most 20 characters, and saved names persist. Adapt to your actual app requirements.",
    "scenarios": [
      {
        "id": "valid-name",
        "category": "valid",
        "objective": "Profile name: valid",
        "setup": [
          {
            "action": "tap",
            "target": {
              "text": "Edit profile"
            }
          }
        ],
        "steps": [
          {
            "action": "type",
            "target": {
              "resource_id": "com.example.app:id/display_name"
            },
            "value": "Ada",
            "clear": true,
            "expect_change": false
          },
          {
            "action": "tap",
            "target": {
              "text": "Save"
            },
            "expect_change": false
          }
        ],
        "cleanup": [
          {
            "action": "tap",
            "target": {
              "text": "Edit profile"
            }
          },
          {
            "action": "type",
            "target": {
              "resource_id": "com.example.app:id/display_name"
            },
            "value": "Original name",
            "clear": true,
            "expect_change": false
          },
          {
            "action": "tap",
            "target": {
              "text": "Save"
            },
            "expect_change": false
          }
        ],
        "verification": {
          "type": "postcondition",
          "texts": [
            "Ada"
          ]
        }
      },
