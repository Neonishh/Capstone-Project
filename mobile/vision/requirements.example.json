      {
        "id": "cancel-edit",
        "category": "cancellation",
        "objective": "Cancelling preserves original name",
        "setup": [
          {
            "action": "tap",
            "target": {
              "text": "Edit profile"
            }
          },
          {
            "action": "type",
            "target": {
              "resource_id": "com.example.app:id/display_name"
            },
