# Copy to mobile/.env; never commit the real .env.
# Default local provider: install/start Ollama and pull this model separately.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=60

# To use Gemini, change LLM_PROVIDER above to gemini and fill in your key.
# GEMINI_API_KEY=your_private_key
# GEMINI_MODEL=gemini-2.5-flash

APPIUM_HOST=localhost
APPIUM_PORT=4723

# Generic fallback only. For equivalent UI detection, obtain the team's
# custom weights privately and set MOBILE_YOLO_MODEL=models/android_ui.pt.
MOBILE_YOLO_MODEL=yolov8n.pt
MOBILE_YOLO_CONFIDENCE=0.25
MOBILE_TORCH_THREADS=4

# Optional shared database. Get credentials privately; keep local-only first.
DB_UPLOAD_ENABLED=false
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_private_server_key

# Vision exploration budget is a CLI argument: --max-steps 30.
# Vercel AI Gateway is not implemented in this checkout.
